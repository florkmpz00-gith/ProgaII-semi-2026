<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@color/light_bg">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#1C1410"
            android:textSize="32sp"
            android:padding="4dp"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Editar Perfil"
            android:textColor="#1C1410"
            android:textSize="20sp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Foto de perfil -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/ivFotoPerfil"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_avatar"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnFotoGaleria"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Galería"
                        android:textColor="#7B5EA7"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/bg_card_purple_light"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/btnFotoCamara"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Cámara"
                        android:textColor="#7B5EA7"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/bg_card_purple_light"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Nombre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre"
                android:textColor="@color/gray_muted"
                android:textSize="12sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:textColor="#1C1410"
                android:textColorHint="@color/gray_muted"
                android:textSize="14sp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="16dp"/>

            <!-- Edad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edad"
                android:textColor="@color/gray_muted"
                android:textSize="12sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etEdad"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:textColor="#1C1410"
                android:textColorHint="@color/gray_muted"
                android:textSize="14sp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="number"
                android:layout_marginBottom="16dp"/>

            <!-- Género -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Género"
                android:textColor="@color/gray_muted"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/btnFemenino"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="♀ Femenino"
                    android:textColor="#1C1410"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:background="@drawable/bg_input"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/btnMasculino"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="♂ Masculino"
                    android:textColor="#1C1410"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:background="@drawable/bg_input"/>

            </LinearLayout>

            <!-- Boton guardar -->
            <TextView
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Guardar cambios"
                android:textColor="@color/white_primary"
                android:textSize="14sp"
                android:gravity="center"
                android:background="@drawable/bg_avatar"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>