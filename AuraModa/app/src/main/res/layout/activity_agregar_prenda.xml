<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@color/light_bg">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#1C1410"
            android:textSize="32sp"
            android:padding="4dp"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nueva Prenda"
            android:textColor="#1C1410"
            android:textSize="20sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Sección 1: Info básica -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_light"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 Información básica"
                    android:textColor="@color/gold"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre"
                    android:textColor="@color/gray_muted"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etNombrePrenda"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="Ej: Jeans skinny"
                    android:textColor="#1C1410"
                    android:textColorHint="@color/gray_muted"
                    android:textSize="14sp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color"
                    android:textColor="@color/gray_muted"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etColorPrenda"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="Ej: Azul oscuro"
                    android:textColor="#1C1410"
                    android:textColorHint="@color/gray_muted"
                    android:textSize="14sp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>

            </LinearLayout>

            <!-- Sección 2: Tipo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_light"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👗 Tipo de prenda"
                    android:textColor="@color/purple"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvTipoSeleccionado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seleccionado: Camiseta"
                    android:textColor="@color/gold"
                    android:textSize="11sp"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/chipCamiseta"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="Camiseta"
                        android:textColor="@color/black_primary"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip_active"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/chipPantalon"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="Pantalón"
                        android:textColor="@color/gray_muted"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:background="@drawable/bg_input"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/chipVestido"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="Vestido"
                        android:textColor="@color/gray_muted"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:background="@drawable/bg_input"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/chipChaqueta"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="Chaqueta"
                        android:textColor="@color/gray_muted"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:background="@drawable/bg_input"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/chipZapatos"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="Zapatos"
                        android:textColor="@color/gray_muted"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:background="@drawable/bg_input"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/chipAccesorio"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="Accesorio"
                        android:textColor="@color/gray_muted"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:background="@drawable/bg_input"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipFalda"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="Falda"
                        android:textColor="@color/gray_muted"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:background="@drawable/bg_input"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/chipBlusa"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="Blusa"
                        android:textColor="@color/gray_muted"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:background="@drawable/bg_input"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/chipShorts"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="Shorts"
                        android:textColor="@color/gray_muted"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:background="@drawable/bg_input"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Sección 3: Talla -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_teal"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📏 Talla"
                    android:textColor="#5A9E8E"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvTallaSeleccionada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seleccionada: S"
                    android:textColor="#5A9E8E"
                    android:textSize="11sp"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipXS"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="XS"
                        android:textColor="@color/gray_muted"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:background="@drawable/bg_input"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/chipS"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="S"
                        android:textColor="@color/black_primary"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip_active"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/chipM"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="M"
                        android:textColor="@color/gray_muted"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:background="@drawable/bg_input"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/chipL"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="L"
                        android:textColor="@color/gray_muted"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:background="@drawable/bg_input"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/chipXL"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="XL"
                        android:textColor="@color/gray_muted"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:background="@drawable/bg_input"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Botón guardar -->
            <TextView
                android:id="@+id/btnGuardarPrenda"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Guardar prenda"
                android:textColor="@color/white_primary"
                android:textSize="15sp"
                android:gravity="center"
                android:textStyle="bold"
                android:background="@drawable/bg_avatar"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>