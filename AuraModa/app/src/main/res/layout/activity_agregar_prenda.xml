<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_primary"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@color/black_primary">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="@color/white_primary"
            android:textSize="22sp"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Agregar Prenda"
            android:textColor="@color/white_primary"
            android:textSize="20sp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre de la prenda"
                android:textColor="@color/gray_muted"
                android:textSize="12sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etNombrePrenda"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Ej: Jeans azules"
                android:textColor="@color/white_primary"
                android:textColorHint="@color/gray_muted"
                android:textSize="14sp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de prenda"
                android:textColor="@color/gray_muted"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvTipoSeleccionado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo: Camiseta"
                android:textColor="@color/gold"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/chipCamiseta"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="Camiseta"
                    android:textColor="@color/black_primary"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_chip_active"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/chipPantalon"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="Pantalón"
                    android:textColor="@color/gray_muted"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/chipVestido"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="Vestido"
                    android:textColor="@color/gray_muted"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/chipChaqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="Chaqueta"
                    android:textColor="@color/gray_muted"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/chipZapatos"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="Zapatos"
                    android:textColor="@color/gray_muted"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/chipAccesorio"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="Accesorio"
                    android:textColor="@color/gray_muted"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Color"
                android:textColor="@color/gray_muted"
                android:textSize="12sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etColorPrenda"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Ej: Azul oscuro"
                android:textColor="@color/white_primary"
                android:textColorHint="@color/gray_muted"
                android:textSize="14sp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/btnGuardarPrenda"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Guardar prenda"
                android:textColor="@color/white_primary"
                android:textSize="14sp"
                android:gravity="center"
                android:background="@drawable/bg_avatar"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>