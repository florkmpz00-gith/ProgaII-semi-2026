<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_primary"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@color/black_primary">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="@color/white_primary"
            android:textSize="22sp"
            android:layout_marginEnd="12dp"/>

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_avatar"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Estilista IA"
            android:textColor="@color/white_primary"
            android:textSize="16sp"/>

    </LinearLayout>

    <!-- Nav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#111111">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Inicio"
            android:textColor="@color/gray_muted"
            android:textSize="11sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Chat IA"
            android:textColor="@color/gold"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/bg_nav_selected"/>

        <TextView
            android:id="@+id/navTryOn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Try-On"
            android:textColor="@color/gray_muted"
            android:textSize="11sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Perfil"
            android:textColor="@color/gray_muted"
            android:textSize="11sp"
            android:gravity="center"/>

    </LinearLayout>

    <!-- Lista de mensajes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false"/>

    <!-- Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#111111">

        <EditText
            android:id="@+id/etMensaje"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:hint="Pregunta algo..."
            android:textColor="@color/white_primary"
            android:textColorHint="@color/gray_muted"
            android:textSize="13sp"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/btnEnviar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="▶"
            android:textColor="@color/white_primary"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/bg_avatar"/>

    </LinearLayout>

</LinearLayout>