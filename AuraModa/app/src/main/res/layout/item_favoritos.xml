<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_gold"
    android:padding="12dp"
    android:layout_margin="6dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/ivFavFoto"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:scaleType="centerCrop"
        android:background="@color/black_surface"
        android:layout_marginEnd="12dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFavTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Outfit"
            android:textColor="@color/gold"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvFavFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guardado hoy"
            android:textColor="@color/gray_muted"
            android:textSize="11sp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/btnEliminar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:text="✕"
        android:textColor="@color/rose"
        android:textSize="16sp"
        android:gravity="center"/>

</LinearLayout>