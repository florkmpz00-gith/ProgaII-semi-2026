<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_primary"
    android:orientation="vertical">

    <!-- Topbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@color/black_primary">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/logo_auramoda"
            android:scaleType="fitCenter"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AuraModa"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:letterSpacing="0.1"/>

        <TextView
            android:id="@+id/tvUserAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="F"
            android:textColor="@color/white_primary"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/bg_avatar"/>

    </LinearLayout>

    <!-- Contenido scrollable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Saludo -->
            <TextView
                android:id="@+id/tvSaludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buenas noches, Flor!"
                android:textColor="@color/gray_muted"
                android:textSize="13sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inspirate, crea tu look"
                android:textColor="@color/white_primary"
                android:textSize="22sp"
                android:layout_marginBottom="20dp"/>

            <!-- Card outfit del dia -->
            <LinearLayout
                android:id="@+id/cardIA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_purple"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OUTFIT DEL DIA"
                    android:textColor="#DDD6FE"
                    android:textSize="10sp"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvOutfitIA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargando recomendacion..."
                    android:textColor="@color/white_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/btnVerOutfit"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Chatear con IA"
                    android:textColor="@color/white_primary"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_btn_outline_white"/>

            </LinearLayout>

            <!-- Tus estilos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tus estilos"
                android:textColor="@color/white_primary"
                android:textSize="16sp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/layoutEstilos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp"/>

            <!-- Quick cards -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explorar"
                android:textColor="@color/white_primary"
                android:textSize="16sp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/cardGaleria"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_gold"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Galeria"
                        android:textColor="@color/gold"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pexels API"
                        android:textColor="@color/gray_muted"
                        android:textSize="10sp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardFavoritos"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_rose">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#9829;"
                        android:textSize="22sp"
                        android:textColor="@color/purple"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Favoritos"
                        android:textColor="@color/purple"
                        android:textSize="13sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Guardados"
                        android:textColor="@color/gray_muted"
                        android:textSize="10sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Card perfil -->
            <LinearLayout
                android:id="@+id/cardPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_gold"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvAvatarPerfil"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:text="F"
                    android:textColor="@color/white_primary"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:background="@drawable/bg_avatar"
                    android:layout_marginEnd="14dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombrePerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Flor"
                        android:textColor="@color/white_primary"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver perfil"
                        android:textColor="@color/gold"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom nav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#111111"
        android:gravity="center">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Casa"
            android:textColor="@color/gold"
            android:textSize="11sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/navGaleria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Galeria"
            android:textColor="@color/gray_muted"
            android:textSize="11sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chat IA"
            android:textColor="@color/gray_muted"
            android:textSize="11sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Perfil"
            android:textColor="@color/gray_muted"
            android:textSize="11sp"
            android:gravity="center"/>

    </LinearLayout>

</LinearLayout>