<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF6F1"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="#FAF6F1">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/logo_auramoda"
            android:scaleType="fitCenter"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AuraModa"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:letterSpacing="0.1"/>

        <TextView
            android:id="@+id/tvUserAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="F"
            android:textColor="@color/white_primary"
            android:textSize="15sp"
            android:gravity="center"
            android:background="@drawable/bg_avatar"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:background="#FFF8F2">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Inicio"
            android:textColor="@color/gold"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/bg_nav_selected"/>

        <TextView
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Chat IA"
            android:textColor="@color/gray_muted"
            android:textSize="11sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/navTryOn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Try-On"
            android:textColor="@color/gray_muted"
            android:textSize="11sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Compartir"
            android:textColor="@color/gray_muted"
            android:textSize="11sp"
            android:gravity="center"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSaludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buenas tardes, Flor!"
                android:textColor="@color/gray_muted"
                android:textSize="13sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inspirate, crea tu look"
                android:textColor="#1C1410"
                android:textSize="22sp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/layoutEstilos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explorar"
                android:textColor="#1C1410"
                android:textSize="15sp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/cardGaleria"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_card_light"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="3dp"
                        android:background="@color/gold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Galería"
                        android:textColor="@color/gold"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Outfits de moda"
                        android:textColor="@color/gray_muted"
                        android:textSize="10sp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardArmario"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_card_light"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="3dp"
                        android:background="@color/purple"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mi Armario"
                        android:textColor="@color/purple"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Combinaciones IA"
                        android:textColor="@color/gray_muted"
                        android:textSize="10sp"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardTryOn"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_purple_light"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Virtual Try-On"
                        android:textColor="#7B5EA7"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Probate outfits con IA"
                        android:textColor="@color/gray_muted"
                        android:textSize="11sp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textColor="#9B85C4"
                    android:textSize="28sp"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoy te recomiendo"
                android:textColor="#1C1410"
                android:textSize="15sp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/cardIA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_teal"
                android:padding="18dp"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OUTFIT DEL DÍA"
                    android:textColor="#5A9E8E"
                    android:textSize="9sp"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvOutfitIA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargando recomendacion..."
                    android:textColor="#1C3530"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.5"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/btnVerOutfit"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Chatear con IA"
                    android:textColor="#5A9E8E"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_btn_outline_white"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>